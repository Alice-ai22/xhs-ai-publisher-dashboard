{
  "name": "xhs-ai-publisher-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted Xiaohongshu content workflow dashboard with topic management, draft review, scheduling, and manual publishing support.",
  "keywords": [
    "nextjs",
    "typescript",
    "prisma",
    "sqlite",
    "openai",
    "xiaohongshu",
    "content-workflow",
    "creator-tools"
  ],
  "homepage": "https://github.com/Alice-ai22/xhs-ai-publisher-dashboard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alice-ai22/xhs-ai-publisher-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/Alice-ai22/xhs-ai-publisher-dashboard/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^5.22.0",
    "date-fns": "^4.1.0",
    "next": "16.2.4",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
